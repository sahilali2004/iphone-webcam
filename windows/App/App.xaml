<Application x:Class="PhoneWebcam.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Tally light: the one signal colour set in the app. -->
        <SolidColorBrush x:Key="TallyLiveBrush" Color="#E5322D" />
        <SolidColorBrush x:Key="TallyBusyBrush" Color="#E8A317" />
        <SolidColorBrush x:Key="TallyIdleBrush" Color="#8A8A8E" />
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    </Application.Resources>
</Application>
