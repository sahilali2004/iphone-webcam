<Window x:Class="PhoneWebcam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoneWebcam.App.ViewModels"
        xmlns:local="clr-namespace:PhoneWebcam.App"
        Title="Phone Webcam"
        Width="1120" Height="760" MinWidth="820" MinHeight="560"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolConverter x:Key="Inverse" />

        <!-- Small grey caption above a value: sentence case, no tracking. -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Two-way segmented choice built from radio buttons styled as toggles. -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,6" />
        </Style>

        <!-- Viewfinder corner bracket (top-left orientation; others are rotated copies). -->
        <Style x:Key="Corner" TargetType="Path">
            <Setter Property="Data" Value="M0,22 L0,0 L22,0" />
            <Setter Property="Stroke" Value="#D8FFFFFF" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="14" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20,16,20,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Viewfinder: the main element. Always black, like a camera monitor, regardless of theme. -->
        <Border Grid.Column="0" CornerRadius="6" Background="Black" ClipToBounds="True">
            <Grid>
                <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <TextBlock Text="{Binding Status}" FontFamily="{StaticResource DisplayFont}" FontSize="24"
                               Foreground="#F2F2F2" TextAlignment="Center" />
                    <TextBlock Text="{Binding StatusDetail}" FontSize="13" Foreground="#A0A0A6"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Pairing prompt, over the viewfinder because it's what the user must deal with now. -->
                <Border Visibility="{Binding ShowPairing, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        CornerRadius="8" Padding="24,20" MinWidth="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Pair with this phone" FontFamily="{StaticResource DisplayFont}" FontSize="20" />
                        <TextBlock Text="Type the 6-digit code shown on the phone." Style="{StaticResource Caption}" Margin="0,4,0,14" FontSize="13" />
                        <TextBox x:Name="PairingCodeBox" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="28" MaxLength="6" TextAlignment="Center"
                                 Typography.NumeralAlignment="Tabular" InputScope="Number" />
                        <TextBlock Text="{Binding PairingError}" Foreground="{StaticResource TallyLiveBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button Content="Pair" Command="{Binding SubmitPairingCommand}" IsDefault="True"
                                Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                Margin="0,12,0,0" Padding="0,8" />
                    </StackPanel>
                </Border>

                <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform>
                </Path>
                <Path Style="{StaticResource Corner}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                </Path>
                <Path Style="{StaticResource Corner}" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Path.RenderTransform><RotateTransform Angle="270" /></Path.RenderTransform>
                </Path>
            </Grid>
        </Border>

        <!-- Side panel: status → phone & camera choices → stream numbers (scrolls if short) → webcam button (always visible). -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <DockPanel LastChildFill="False" Margin="0,0,14,0">

            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="TallyLight" Width="12" Height="12" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TallyIdleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tally}" Value="{x:Static vm:Tally.Busy}">
                                        <Setter Property="Fill" Value="{StaticResource TallyBusyBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tally}" Value="{x:Static vm:Tally.Live}">
                                        <Setter Property="Fill" Value="{StaticResource TallyLiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Caption}" FontSize="13" Margin="22,2,0,0" />
            </StackPanel>

            <Separator DockPanel.Dock="Top" Margin="0,14" />

            <!-- Choices -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Phone" Style="{StaticResource Caption}" />
                <ComboBox x:Name="DevicePicker" ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Label" HorizontalAlignment="Stretch" />

                <Grid Margin="0,8,0,0" Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" Grid.Column="0" Text="{Binding ManualHost, UpdateSourceTrigger=PropertyChanged}" ToolTip="Phone's Wi-Fi address, shown in the phone app" />
                    <TextBox x:Name="PortBox" Grid.Column="2" Text="{Binding ManualPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Port" />
                    <Button Grid.Column="4" Content="Connect" Command="{Binding ApplyManualCommand}" Padding="10,5" />
                </Grid>

                <TextBlock Text="Camera" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="RearButton" Content="Rear" GroupName="Camera" IsChecked="{Binding IsRear}" Style="{StaticResource Segment}" Margin="0,0,3,0" />
                    <RadioButton x:Name="FrontButton" Content="Front" GroupName="Camera" IsChecked="{Binding IsFront}" Style="{StaticResource Segment}" Margin="3,0,0,0" />
                </UniformGrid>

                <TextBlock Text="Quality" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                <UniformGrid Columns="2">
                    <RadioButton x:Name="Res720Button" Content="720p" GroupName="Quality" IsChecked="{Binding Is720}" Style="{StaticResource Segment}" Margin="0,0,3,0" />
                    <RadioButton x:Name="Res1080Button" Content="1080p" GroupName="Quality" IsChecked="{Binding Is1080}" Style="{StaticResource Segment}" Margin="3,0,0,0" />
                </UniformGrid>

                <TextBlock Text="Microphone" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                <CheckBox x:Name="MicrophoneCheck" Content="Use phone microphone" IsChecked="{Binding MicrophoneOn}" />
                <ComboBox x:Name="AudioPicker" ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                          DisplayMemberPath="Label" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                          ToolTip="Where the phone's microphone is played. Pick a virtual cable to use it as a microphone in other apps."
                          Visibility="{Binding MicrophoneOn, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding MicrophoneText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <Separator DockPanel.Dock="Top" Margin="0,14" />

            <!-- Stream numbers: two columns, values aligned. -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Resolution" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ResolutionText}" Style="{StaticResource Value}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="Frame rate" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding FpsText}" Style="{StaticResource Value}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Latency" Style="{StaticResource Caption}" ToolTip="Capture on the phone to decoded on this PC" />
                    <TextBlock Text="{Binding LatencyText}" Style="{StaticResource Value}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Bitrate" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding BitrateText}" Style="{StaticResource Value}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Dropped frames" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding DropsText}" Style="{StaticResource Value}" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1">
                    <TextBlock Text="Connection" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ConnectionText}" Style="{StaticResource Value}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            </DockPanel>
            </ScrollViewer>

            <!-- Webcam button pinned to the bottom of the panel. -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                <TextBlock Text="{Binding VirtualCameraText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button x:Name="WebcamButton" Content="{Binding WebcamButtonText}" Command="{Binding ToggleWebcamCommand}"
                        Style="{DynamicResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Padding="0,12" FontSize="16" />
            </StackPanel>
        </Grid>

        <!-- Last log line: quiet, for diagnosing without opening the log file. -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding LastLog}" Margin="2,10,0,0"
                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
